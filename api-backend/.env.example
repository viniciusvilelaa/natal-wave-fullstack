# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Database & PostgreSQL (Docker / Prisma)
# ==========================================
DATABASE_URL="postgresql://dev:dev@localhost:5432/maritime_forecast?schema=public"
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=maritime_forecast
POSTGRES_PORT=5432

# ==========================================
# Authentication & Security (JWT & Bcrypt)
# ==========================================
JWT_SECRET="seu_jwt_secret_muito_seguro_e_longo_aqui"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=10

# ==========================================
# OAuth Integrations (Google & Apple)
# ==========================================
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
APPLE_CLIENT_ID="com.suaempresa.seuapp"

# ==========================================
# External APIs (Stormglass Weather/Ocean Data)
# ==========================================
STORMGLASS_API_URL="https://api.stormglass.io/v2"
STORMGLASS_API_KEY="sua_api_key_stormglass"

# ==========================================
# Business Rules & Cache Configuration
# ==========================================
# Cache de previsão em horas
FORECAST_CACHE_TTL_HOURS=6

# Raio padrão (em km) para busca de praias próximas
NEARBY_BEACH_RADIUS_KM=50
